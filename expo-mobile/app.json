{
  "expo": {
    "name": "E-Stock",
    "slug": "E-Stock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_image.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#6A8EFE",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app_image.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A8EFE"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_image.png",
        "backgroundColor": "#6A8EFE"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
